{
  "name": "@helve-dev/openclaw-helve-search",
  "version": "0.1.0",
  "description": "OpenClaw web search provider plugin backed by Helve — one HELVE_API_KEY with ordered fallback across Brave, Tavily, Exa, and Serper plus per-key spend_limit_usd caps at 0% markup.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "clawhub",
    "web-search",
    "helve",
    "brave",
    "tavily",
    "exa",
    "serper"
  ],
  "homepage": "https://helve.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/helve-dev/openclaw-helve-search"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:helve/openclaw-helve-search",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.3.24-beta.2",
      "allowInvalidConfigRecovery": true,
      "npmSpec": "@helve-dev/openclaw-helve-search"
    },
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  }
}
